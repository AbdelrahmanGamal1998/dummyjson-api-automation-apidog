{
  "name": "dummyjson-api-automation-apidog",
  "version": "1.0.0",
  "description": "API test automation for dummyjson.com with Apidog CLI, an OpenAPI spec and GitHub Actions",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "apidog run tests/dummyjson-api-tests.apidog-cli.json -r cli,html,junit --out-dir reports",
    "lint:spec": "redocly lint apis/openapi.yaml --format=stylish",
    "preview:spec": "redocly preview-docs apis/openapi.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "^2.65.0",
    "apidog-cli": "^2.2.12"
  }
}
